# ====================================
# StudyOwl Bot Configuration
# ====================================

# ===== Discord Bot Settings (Required) =====

# Discord Bot Token
# Get from: https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Discord Application ID
# Get from: Discord Developer Portal → Your App → General Information
APPLICATION_ID=your_application_id_here

# Discord Guild (Server) ID
# Enable Developer Mode → Right-click server → Copy ID
GUILD_ID=your_guild_id_here


# ===== Admin Configuration (Required) =====

# Admin User IDs (comma-separated)
# Enable Developer Mode → Right-click user → Copy ID
# Example: 123456789012345678,987654321098765432
ADMIN_USER_IDS=123456789,987654321


# ===== Server Settings (Optional) =====

# Koyeb App URL for Self Ping (prevents sleep)
# Format: https://your-app-name.koyeb.app/health
# Leave empty if not using Koyeb
KOYEB_URL=

# Server Port for Health Check
# Default: 8000
PORT=8000
